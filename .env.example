DATABASE_URL=postgresql://user:password@localhost:5432/bookhunt
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
LLM_TEXT_MODELS=google:gemini-3.1-flash-lite,anthropic:claude-haiku-4-5,openai:gpt-4o-mini
# Transactional email: the sign-up verification link and the password reset
# link. Optional -- with RESEND_API_KEY unset nothing is sent and the whole
# message, including the link, is written to the server console instead. That is
# what makes registration runnable locally without a mail account.
RESEND_API_KEY=re_...
# A display name is worth carrying here -- Resend accepts the "Name <address>"
# form. A bare address is less recognisable in an inbox list, and for a domain
# with no sending history recognisability is one of the few levers there is.
EMAIL_FROM=BookHunt <noreply@bookhunt.net>
# Optional. Set as the Reply-To header, so the sender can be replied to; a
# no-reply address that silently discards mail is a mild negative signal to
# filters and a worse experience for the reader.
EMAIL_REPLY_TO=
FRONTEND_URL=http://localhost:5173
PORT=3001
# Number of reverse proxies in front of this API, so rate limits key on the
# caller's IP rather than the proxy's. A count, so add to it for anything in
# front of the BFF in production -- a CDN or load balancer makes it 2.
#
# 1 matches the standard setup, where the BFF (bookhunt-web's server/) is the
# only hop and always sends X-Forwarded-For. Clear it when reaching the API
# directly with nothing in front: trusting a forwarded header nobody sets would
# let clients forge it, and express-rate-limit warns on every request when the
# two disagree.
TRUSTED_PROXY_HOPS=1
GOOGLE_BOOKS_API_KEY=
OPENLIBRARY_API_URL=https://openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org
BOOKS_SEARCH_PROVIDERS=google_books,open_library

# Retry behaviour for book provider lookups. Both providers return intermittent
# 429s and 503s under bursts, and a swallowed one reads as "no such book".
#
# The two multiply: a row makes at most BOOKS_HTTP_ATTEMPTS x
# BOOKS_PRIMARY_ATTEMPTS requests before falling back to the secondary provider.
# Only failures are retried — a provider that answers "no results" is believed.
BOOKS_HTTP_ATTEMPTS=2
BOOKS_HTTP_BACKOFF_MS=250
BOOKS_PRIMARY_ATTEMPTS=3
BOOKS_PRIMARY_BACKOFF_MS=500
# Response cache for LLM search answers and book provider lookups (LOS-185).
# Optional: leave it unset and every read is a miss, which is exactly how the
# app behaved before the cache existed. `docker compose up -d redis` starts one
# locally. Redis being unreachable degrades to misses, never to errors.
REDIS_URL=

LOG_LLM_QUERIES=false
LOG_DB_QUERIES=false
LOG_BOOKS_PROVIDER_QUERIES=false
# Cache hits, misses and writes, with the key and elapsed time. Worth turning on
# whenever the cache looks inert: every one of its failure modes is shaped like a
# miss, so a dead cache and a cold one are otherwise indistinguishable.
LOG_CACHE_QUERIES=false

# invite | open. Anything other than "open" requires an invite code to register
# (LOS-376), so an unset or misspelt value closes registration rather than
# opening it. Mint codes with: node scripts/mint-invite.js --new "for Sam"
REGISTRATION_MODE=invite

# Where the daily invite-request digest goes (LOS-381). Unset means the job
# does nothing rather than guessing an address. Run by host cron:
#   0 8 * * * cd /opt/bookhunt-deploy && \
#     docker compose exec -T api node /app/scripts/invite-digest.js
INVITE_DIGEST_TO=
