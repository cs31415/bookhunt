DATABASE_URL=postgresql://user:password@localhost:5432/bookhunt
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
LLM_TEXT_MODELS=google:gemini-3.1-flash-lite,anthropic:claude-haiku-4-5,openai:gpt-4o-mini
LLM_VISION_MODELS=anthropic:claude-haiku-4-5,openai:gpt-4o-mini,google:gemini-3.1-flash-lite
# Transactional email: the sign-up verification link and the password reset
# link. Optional -- with RESEND_API_KEY unset nothing is sent and the whole
# message, including the link, is written to the server console instead. That is
# what makes registration runnable locally without a mail account.
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@bookhunt.app
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=bookhunt-uploads
FRONTEND_URL=http://localhost:5173
PORT=3001
GOOGLE_BOOKS_API_KEY=
OPENLIBRARY_API_URL=https://openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org
BOOKS_SEARCH_PROVIDERS=google_books,open_library

# Retry behaviour for book provider lookups. Both providers return intermittent
# 429s and 503s under bursts, and a swallowed one reads as "no such book".
#
# The two multiply: a row makes at most BOOKS_HTTP_ATTEMPTS x
# BOOKS_PRIMARY_ATTEMPTS requests before falling back to the secondary provider.
# Only failures are retried — a provider that answers "no results" is believed.
BOOKS_HTTP_ATTEMPTS=2
BOOKS_HTTP_BACKOFF_MS=250
BOOKS_PRIMARY_ATTEMPTS=3
BOOKS_PRIMARY_BACKOFF_MS=500
# Response cache for LLM search answers and book provider lookups (LOS-185).
# Optional: leave it unset and every read is a miss, which is exactly how the
# app behaved before the cache existed. `docker compose up -d redis` starts one
# locally. Redis being unreachable degrades to misses, never to errors.
REDIS_URL=

LOG_LLM_QUERIES=false
LOG_DB_QUERIES=false
LOG_BOOKS_PROVIDER_QUERIES=false
# Cache hits, misses and writes, with the key and elapsed time. Worth turning on
# whenever the cache looks inert: every one of its failure modes is shaped like a
# miss, so a dead cache and a cold one are otherwise indistinguishable.
LOG_CACHE_QUERIES=false